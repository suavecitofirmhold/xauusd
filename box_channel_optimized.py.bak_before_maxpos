        ma_dist_lowvol_mult=1.0,      # 低波动阈值: atr_now/atr_avg < 此值视为低波动(配合 ma_dist_regime_cond)
        # 自适应 r_mult(第4步): 1h 通道斜率幅度 |rel| 越大(趋势越强) → r_mult 越高
