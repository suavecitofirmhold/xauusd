//+------------------------------------------------------------------+
//|                                        BoxChannelScalp.mq5        |
//|  XAUUSD M15 箱体通道 scalp —— 忠实移植自 backtrader 回测           |
//|  回测源: box_channel_optimized.py  PROFILES["scalp"] (趋势过滤MA96)|
//|                                                                    |
//|  参数默认值 = 回测最终采用的 scalp 画像 + 验证推荐手数 0.01         |
//|  移植对照与偏差说明见同目录 README_port.md                          |
//+------------------------------------------------------------------+
#property copyright "ported from box_channel_optimized.py"
#property version   "1.00"
#property strict
#property description "XAUUSD M15 box-channel scalp + MA96 trend filter"

#include <Trade\Trade.mqh>

//=================== 输入参数(与回测 PROFILES['scalp'] 一一对应) ===================
input group "===== 周期 / 通道 ====="
input int    InpTrendWindow       = 24;      // 1h 通道窗口 (trend_window)
input double InpRelSlopeThresh    = 0.0004;  // 通道斜率阈值 (rel_slope_thresh)
input int    InpShortTrendN       = 20;      // 15m 短期方向窗口 (short_trend_n)

input group "===== 支撑压力聚类 ====="
input int    InpShortWin          = 8;       // 15m 聚类窗口 (short_win)  ← 4→8 对齐 Python scalp 默认(支撑回看加长, 过滤噪声刺穿)
input int    InpLongWin           = 4;       // 1h 聚类窗口 (long_win)
input int    InpMinK              = 2;       // 密集区最少K线 (min_k)
input int    InpClusterBins       = 20;      // 直方图分箱 (cluster_bins)
input double InpRevTol            = 0.0015;  // 反转容差 (rev_tol)

input group "===== 入场确认 ====="
input bool   InpUseReversalFilter = true;    // 反转K线过滤
input double InpMinWickRatio      = 0.6;     // 影线比例 (min_wick_ratio)
input int    InpRsiPeriod         = 14;      // RSI 周期
input double InpRsiOverbought     = 70;      // 超买
input double InpRsiOversold       = 30;      // 超卖
input int    InpCooldownBars      = 2;       // 同向冷却根数 (cooldown_bars)

input group "===== 趋势过滤(已采用 MA96) ====="
input bool   InpMAFilter          = true;    // ma_filter
input int    InpMAFilterPeriod    = 96;      // ma_filter_period

input group "===== 止损 / 止盈 ====="
input bool   InpUseAtrStop        = true;    // atr_stop
input int    InpAtrPeriod         = 14;      // atr_period
// ⚠️ 源码默认必须是 1.5(已验证值)。曾用 1.0 → PF 0.79 亏损;
//    1.5 = MT5 Tester 全样本验证值(+32.75%/PF1.173); 1.3 = Python walk-forward 更优值(待 EA 侧验证后再升)
input double InpAtrStopMult       = 1.5;     // atr_stop_mult
input double InpRMult             = 1.75;    // r_mult (止盈倍数)
input bool   InpTrailing          = true;    // trailing 追踪止盈
input double InpTrailActivateAtr  = 1.0;     // 两段式追踪①激活门限: 浮盈达此×ATR才启动(0=始终, 原EA=0); 对齐Python trail_activate_atr
input double InpTrailAtrMult      = 1.0;     // 两段式追踪②跟随距离×ATR(取代InpAtrStopMult用于追踪, 更小=更早锁利); 对齐Python trail_atr_mult
input double InpTrailBeBuffer     = 0.0;     // 两段式追踪③保本缓冲: 启动后SL先弹到 entry±此×ATR(0=不启用); 对齐Python trail_be_buffer

input group "===== ATR Regime 门(已采用 on 1.2) ====="
input bool   InpAtrRegimeGate    = true;    // atr_regime_gate (walk-forward 5-regime 验证: on 1.2 分段正 4/5 vs off 2/5)
input int    InpAtrRegimePeriod  = 48;      // atr_regime_period (ATR 的 SMA 窗口)
input double InpAtrRegimeMult    = 1.2;     // atr_regime_mult (ATR/SMA>此值则跳过入场, 避高波动)

input group "===== 远离趋势过滤(MA 距离, 对应 Python max_ma_dist_atr) ====="
input double InpMaDistMax        = 2.5;     // max_ma_dist_atr: 价格远离 EMA96 超过此 ATR 倍数则拒(防低波动段毛刺扫损); 0=关闭
input bool   InpMaDistRegimeCond = true;    // 仅低波动段(atr/atr_avg < InpMaDistLowvolMult)启用; 波动扩张/突破段放行延伸入场
input double InpMaDistLowvolMult = 0.75;    // 低波动阈值: atr/atr_avg < 此值视为低波动(配合 InpMaDistRegimeCond)

input group "===== 仓位 / 风险 ====="
input double InpFixedLot          = 0.01;    // 固定手数(验证推荐: 0.01)
input int    InpMaxSpreadPoints   = 50;      // 点差上限(points), 超过则跳过入场(已上调 35→50, 与 Python 默认一致, 放行亚盘早段)

input group "===== 隔夜控制(用MT5服务器时间) ====="
input bool   InpAvoidOvernight    = true;    // avoid_overnight
input int    InpServerCloseHour   = 22;      // 服务器时间几点强平(零点前2h)
input double InpStrongOvernight   = 0.0020;  // strong_overnight_thresh

input group "===== 实盘保真度 ====="
input bool   InpUseServerStops    = true;    // true=服务器SL/TP; false=bar收盘手动平(更贴近回测)

input group "===== 其它 ====="
input long   InpMagic             = 20260906;// 魔术号
input bool   InpLogTrades         = true;    // 成交写 CSV(MQL5/Files/)
input bool   InpHeartbeat         = true;    // 每根bar打印[HB]心跳, 证明EA在运行(无成交也能在Experts看到)

input group "===== 真实执行优化(时段/挂单) ====="
input int    InpTradeStartHour    = 1;       // 交易时段起点(服务器时, 夏令时 GMT+3 基准) = 北京 06:00; 冬令时由 EffectiveStartHour() 自动-1 仍对齐北京 06:00
input int    InpTradeEndHour      = 22;      // 交易时段终点(服务器时间, 含隔夜强平点)
input int    InpPendingValidBars = 3;       // 限价挂单有效根数(未成交则撤, 重新评估)

//=================== 全局 ===================
CTrade  trade;
datetime g_lastBarTime   = 0;
int      g_lastEntryBar  = -9999;   // 上次入场的 bar 序号
int      g_lastEntrySide = 0;       // 1=long, -1=short

// 当前持仓跟踪
ulong    g_ticket     = 0;
int      g_dir        = 0;          // 1=long, -1=short
double   g_entryPrice = 0;
double   g_stop       = 0;
double   g_target     = 0;
double   g_extreme    = 0;          // 持仓以来最优价(追踪用)
datetime g_entryTime  = 0;
double   g_position_swap = 0.0;     // 当前持仓累计隔夜费(每 tick 刷新, 平仓时写入 CSV)

// 限价挂单跟踪(真实执行优化: 用挂单在支撑/压力处成交, 免去市价单滑点)
ulong    g_pendingTicket = 0;       // 挂单 ticket(BuyLimit/SellLimit)
int      g_pendingBar    = 0;       // 挂单所在 bar 序号
int      g_pendingDir    = 0;       // 挂单方向(1=long, -1=short)
string   g_closeReason   = "";      // 手动平仓原因(由 ClosePosition 写入, OnTick→LogClosedByHistory 回填真实盈亏用)

// 品种状态缓存
double   g_point      = 0;
int      g_digits     = 2;
double   g_volMin     = 0.01, g_volStep = 0.01, g_volMax = 100.0;

// 指标句柄(MQL5 的 iMA/iATR/iRSI 返回句柄, 需配合 CopyBuffer 取值)
int      g_hMA        = INVALID_HANDLE;
int      g_hATR       = INVALID_HANDLE;
int      g_hRSI       = INVALID_HANDLE;

// 诊断计数器(对拍用, 仅统计, 不改任何交易逻辑)
int g_d_newbar  = 0;   // OnNewBar 被调用次数
int g_d_chan0   = 0;   // channel==0(range) 跳过
int g_d_conflict= 0;   // 通道与短周期方向冲突
int g_d_nolevel = 0;   // 支撑/压力缺失
int g_d_want0   = 0;   // 反转/位置条件不满足(want==0)
int g_d_trend   = 0;   // 趋势过滤(MA)挡掉
int g_d_rsi     = 0;   // RSI 极端挡掉
int g_d_cool    = 0;   // 同向冷却挡掉
int g_d_spread  = 0;   // 点差过滤挡掉
int g_d_regime  = 0;   // ATR regime 门挡掉(高波动跳过入场)
int g_d_madist  = 0;   // 远离 MA 距离过滤挡掉(对应 Python max_ma_dist_atr)
int g_d_attempt = 0;   // 通过所有过滤, 真正尝试开仓
int g_d_open    = 0;   // 持仓成交(open 日志)
int g_d_pend    = 0;   // 挂单已下(pend 日志)
int g_d_session = 0;   // 非交易时段挡掉(时段过滤)

// 实盘诊断: 跳过原因日志节流(同原因 30s 内不重复打, 防刷屏; 仍证明 EA 在持续评估)
datetime g_lastSkip = 0;
string   g_lastSkipMsg = "";

// ATR regime 门: 滚动缓冲 ATR, 计算 SMA(atr_regime_period) 与当前 ATR 比值
double g_atrHist[];    // 已收盘 M15 的 ATR 历史(环形)
int    g_atrHistN = 0; // 已填充个数

//=================== 指标取值封装 ===================
double GetMAVal(int shift = 0)
{
   double buf[1];
   if(g_hMA == INVALID_HANDLE) return 0.0;
   if(CopyBuffer(g_hMA, 0, shift, 1, buf) != 1) return 0.0;
   return buf[0];
}
double GetATRVal(int shift = 0)
{
   double buf[1];
   if(g_hATR == INVALID_HANDLE) return 0.0;
   if(CopyBuffer(g_hATR, 0, shift, 1, buf) != 1) return 0.0;
   return buf[0];
}
double GetRSIVal(int shift = 0)
{
   double buf[1];
   if(g_hRSI == INVALID_HANDLE) return 0.0;
   if(CopyBuffer(g_hRSI, 0, shift, 1, buf) != 1) return 0.0;
   return buf[0];
}

//=================== 工具函数 ===================

// 线性回归斜率(MQL5 无 polyfit, 手写等价公式)
// y[] 必须按【时间从旧到新】排列, 与回测 np.polyfit(arange(n), closes, 1) 一致
double LinRegSlope(const double &y[], int n)
{
   if(n < 2) return 0.0;
   double xbar = (n - 1) / 2.0;
   double num = 0.0, den = 0.0;
   for(int i = 0; i < n; i++)
   {
      double dx = i - xbar;
      num += dx * y[i];
      den += dx * dx;
   }
   return (den > 0.0) ? (num / den) : 0.0;
}

double ArrayMean(const double &a[], int n)
{
   if(n <= 0) return 0.0;
   double s = 0.0;
   for(int i = 0; i < n; i++) s += a[i];
   return s / n;
}

// 取 n 根已收盘收盘价(旧->新); shift 1..n, 与回测 next() 的已完成 bar 对齐
bool GetCloses(ENUM_TIMEFRAMES tf, int n, double &out[])
{
   ArrayResize(out, n);
   for(int i = 0; i < n; i++)
      out[i] = iClose(_Symbol, tf, n - i);
   return true;
}

// 通道判定(对应 classify_channel): 返回 1=up, -1=down, 0=range
int ClassifyChannel(double &rel)
{
   int n = InpTrendWindow;
   double closes[];
   GetCloses(PERIOD_H1, n, closes);
   double slope = LinRegSlope(closes, n);
   double mid   = ArrayMean(closes, n);
   rel = (mid > 0.0) ? (slope / mid) : 0.0;
   double cur = iClose(_Symbol, PERIOD_H1, 1);   // 已收盘 H1 bar，对齐回测
   if(rel >  InpRelSlopeThresh && cur >= mid) return  1;
   if(rel < -InpRelSlopeThresh && cur <= mid) return -1;
   return 0;
}

// 15m 短期方向(对应 classify_short_direction)
int ClassifyShortDirection()
{
   int n = InpShortTrendN;
   double closes[];
   GetCloses(PERIOD_M15, n, closes);
   double slope = LinRegSlope(closes, n);
   double mid   = ArrayMean(closes, n);
   double rel   = (mid > 0.0) ? (slope / mid) : 0.0;
   double th    = InpRelSlopeThresh * 0.5;
   if(rel >  th) return  1;
   if(rel < -th) return -1;
   return 0;
}

// 支撑压力聚类(对应 cluster_levels)
void ClusterLevels(ENUM_TIMEFRAMES tf, int n, double &support, double &resistance)
{
   support = 0; resistance = 0;
   if(n < 2) return;
   double highs[], lows[];
   ArrayResize(highs, n);
   ArrayResize(lows,  n);
   for(int i = 0; i < n; i++)
   {
      highs[i] = iHigh(_Symbol, tf, n - i);   // 已收盘 bar，对齐回测
      lows[i]  = iLow (_Symbol, tf, n - i);
   }
   double lo = lows[ArrayMinimum(lows)];
   double hi = highs[ArrayMaximum(highs)];
   if(hi <= lo) { support = lo; resistance = hi; return; }

   double mids[]; ArrayResize(mids, n);
   for(int i = 0; i < n; i++) mids[i] = (highs[i] + lows[i]) / 2.0;

   // 直方图分箱(等价 np.histogram(mids, bins, range=(lo,hi)))
   int bins = InpClusterBins;
   int counts[]; ArrayResize(counts, bins); ArrayInitialize(counts, 0);
   double width = (hi - lo) / bins;
   for(int i = 0; i < n; i++)
   {
      int idx = (int)((mids[i] - lo) / width);
      if(idx >= bins) idx = bins - 1;   // hi 归入最后一箱(与 numpy 一致)
      if(idx < 0)     idx = 0;
      counts[idx]++;
   }
   int best = ArrayMaximum(counts);
   double blo = lo + best * width;
   double bhi = blo + width;

   int cnt = 0; double s = DBL_MAX, r = -DBL_MAX;
   for(int i = 0; i < n; i++)
   {
      if(mids[i] >= blo && mids[i] <= bhi)
      {
         cnt++;
         if(lows[i]  < s) s = lows[i];
         if(highs[i] > r) r = highs[i];
      }
   }
   if(cnt >= InpMinK && cnt > 0) { support = s; resistance = r; }
   else                          { support = lo; resistance = hi; }
}

// 反转K线(对应 detect_reversal)
void DetectReversal(double support, double resistance, bool &revLong, bool &revShort)
{
   revLong = revShort = false;
   // 当前信号 bar = 已收盘 M15 bar (shift=1), 前一根 = shift=2
   double o = iOpen (_Symbol, PERIOD_M15, 1);
   double h = iHigh (_Symbol, PERIOD_M15, 1);
   double l = iLow  (_Symbol, PERIOD_M15, 1);
   double c = iClose(_Symbol, PERIOD_M15, 1);
   double rng = h - l;
   if(rng <= 0.0) return;

   double upper = h - MathMax(o, c);
   double lower = MathMin(o, c) - l;
   bool hammer  = (lower / rng >= InpMinWickRatio) && (c >= o);
   bool hanging = (upper / rng >= InpMinWickRatio) && (c <= o);

   bool bullEngulf = false, bearEngulf = false;
   double po = iOpen (_Symbol, PERIOD_M15, 2);
   double pc = iClose(_Symbol, PERIOD_M15, 2);
   if(pc < po && c > o && c > po) bullEngulf = true;
   if(pc > po && c < o && c < po) bearEngulf = true;

   bool nearSup = (support    > 0.0) && (MathAbs(c - support)    / support    < InpRevTol * 3.0);
   bool nearRes = (resistance > 0.0) && (MathAbs(c - resistance) / resistance < InpRevTol * 3.0);

   revLong  = (hammer  || bullEngulf) && nearSup;
   revShort = (hanging || bearEngulf) && nearRes;
}

// 趋势过滤(对应 _trend_filter_pass 的 ma_filter 部分)
bool TrendFilterPass(int want, double price)
{
   if(!InpMAFilter) return true;
   double ema = GetMAVal(1);   // 已收盘 bar 的 EMA, 对齐回测
   if(ema <= 0.0) return false;
   if(want ==  1 && price <= ema) return false;   // 多头需 price > EMA
   if(want == -1 && price >= ema) return false;   // 空头需 price < EMA
   return true;
}

// 手数规范化(按 broker 的 min/step/max)
double NormalizeLot(double lot)
{
   double v = lot;
   if(v < g_volMin)  v = g_volMin;
   if(v > g_volMax)  v = g_volMax;
   if(g_volStep > 0.0)
      v = g_volMin + MathFloor((v - g_volMin) / g_volStep + 0.5) * g_volStep;
   return NormalizeDouble(v, 2);
}

// 点差过滤
bool SpreadOK()
{
   long spread = 0;
   if(!SymbolInfoInteger(_Symbol, SYMBOL_SPREAD, spread)) return true;
   return ((int)spread <= InpMaxSpreadPoints);
}

// 实盘诊断: 跳过原因日志(节流, 同原因 30s 内不重复打, 防刷屏)
void SkipLog(string msg)
{
   datetime now = TimeCurrent();
   if(now - g_lastSkip < 30 && g_lastSkipMsg == msg) return;
   g_lastSkip = now; g_lastSkipMsg = msg;
   Print("[SKIP] " + msg);
}

//=================== 日志 ===================
void LogTrade(string action, double price, double profit = 0.0, string reason = "", double swap = 0.0)
{
   if(!InpLogTrades) return;
   int h = FileOpen("BoxChannelScalp_trades.csv",
                    FILE_CSV | FILE_READ | FILE_WRITE | FILE_ANSI | FILE_SHARE_READ, ',');
   if(h == INVALID_HANDLE)
      h = FileOpen("BoxChannelScalp_trades.csv", FILE_CSV | FILE_WRITE | FILE_ANSI, ',');
   if(h == INVALID_HANDLE) return;
   FileSeek(h, 0, SEEK_END);
   if(FileSize(h) == 0)
      FileWrite(h, "time", "action", "side", "price", "stop", "target", "profit", "swap", "reason");
   FileWrite(h,
             TimeToString(TimeCurrent(), TIME_DATE | TIME_SECONDS),
             action,
             (g_dir == 1 ? "long" : (g_dir == -1 ? "short" : "")),
             DoubleToString(price,  g_digits),
             DoubleToString(g_stop, g_digits),
             DoubleToString(g_target, g_digits),
             DoubleToString(profit, 2),
             DoubleToString(swap, 2),
             reason);
   FileClose(h);
}

// 从历史取该仓位的平仓价与盈亏
void LogClosedByHistory(ulong ticket, string reason_override = "")
{
   double closePrice = 0.0, profit = 0.0, swap_total = 0.0, commission = 0.0;
   if(HistorySelectByPosition(ticket))
   {
      int total = HistoryDealsTotal();
      for(int i = 0; i < total; i++)
      {
         ulong dt = HistoryDealGetTicket(i);
         if(dt == 0) continue;
         // 测试器中隔夜费以独立的 DEAL_TYPE_SWAP 成交计入, 需对该仓位所有 deal 累加 DEAL_SWAP
         swap_total += HistoryDealGetDouble(dt, DEAL_SWAP);
         long entry = 0;
         if(HistoryDealGetInteger(dt, DEAL_ENTRY, entry) && entry == DEAL_ENTRY_OUT)
         {
            closePrice = HistoryDealGetDouble(dt, DEAL_PRICE);
            profit     = HistoryDealGetDouble(dt, DEAL_PROFIT);
            commission = HistoryDealGetDouble(dt, DEAL_COMMISSION);
         }
      }
   }
   profit += commission + swap_total;
   string r = (reason_override != "" ? reason_override : "broker");
   LogTrade("close", closePrice, profit, r, swap_total);
}

//=================== 开仓(市价单) ===================
// price = 信号 bar 收盘价(入场参考价)
void OpenPosition(int want, double price, double stop, double target)
{
   double lot = NormalizeLot(InpFixedLot);
   double sl  = InpUseServerStops ? NormalizeDouble(stop,   g_digits) : 0.0;
   double tp  = InpUseServerStops ? NormalizeDouble(target, g_digits) : 0.0;
   bool ok = false;

   if(want == 1)
      ok = trade.Buy (lot, _Symbol, 0.0, sl, tp, "boxScalp_long");
   else
      ok = trade.Sell(lot, _Symbol, 0.0, sl, tp, "boxScalp_short");

   if(ok || trade.ResultRetcode() == TRADE_RETCODE_PLACED || trade.ResultRetcode() == TRADE_RETCODE_DONE)
   {
      g_d_open++;
      g_dir        = want;
      g_entryPrice = price;
      g_stop       = stop;
      g_target     = target;
      g_extreme    = price;
      g_entryTime  = TimeCurrent();
      g_ticket     = trade.ResultDeal();
      // 用实际成交价校正
      double dealt = trade.ResultPrice();
      if(dealt > 0.0) g_entryPrice = dealt;
      LogTrade("open", g_entryPrice);
      PrintFormat("[OPEN] %s lot=%.2f entry=%.2f sl=%.2f tp=%.2f",
                  (want == 1 ? "BUY" : "SELL"), lot, g_entryPrice, stop, target);
   }
   else
   {
      PrintFormat("[OPEN FAILED] retcode=%d %s", trade.ResultRetcode(), trade.ResultRetcodeDescription());
   }
}

//=================== 平仓 ===================
void ClosePosition(string reason)
{
   if(g_ticket == 0 && !PositionSelect(_Symbol)) return;
   double sw = g_position_swap;   // 平仓前抓取当前累计隔夜费(保留给下方 OnTick 检测的 broker 行, 不在此 reset)
   bool ok = trade.PositionClose(_Symbol);
   if(ok)
   {
      PrintFormat("[CLOSE] reason=%s", reason);
      g_closeReason = reason;   // 真实盈亏由 OnTick→LogClosedByHistory 从历史回填(避免重复记一行 profit=0 造成 CSV 双倍行)
   }
}

//=================== 持仓管理 ===================
bool ManagePosition(double c, double atr)
{
   if(!PositionSelect(_Symbol)) return false;

   double entry = PositionGetDouble(POSITION_PRICE_OPEN);
   long   type  = PositionGetInteger(POSITION_TYPE);
   int    dir   = (type == POSITION_TYPE_BUY) ? 1 : -1;

   // 追踪止盈(对应回测 trailing 段)
   // 追踪止盈(两段式, 对应 Python box_channel_optimized._maybe_trail)
   //   ① 激活门限: 浮盈未达 InpTrailActivateAtr×ATR 前不追踪(保住原始硬止损 InpAtrStopMult)
   //   ② 收窄跟随: 启动后 SL 贴 历史极值 ± InpTrailAtrMult×ATR(取代 InpAtrStopMult, 可更早锁利)
   //   ③ 保本缓冲: 若启用, 取 max/min(entry±缓冲, 紧跟随) 使 SL 尽早弹过 entry, 根除浮盈回吐
   bool trailHit = false;
   if(InpTrailing)
   {
      if(dir == 1) g_extreme = MathMax(g_extreme, c);
      else         g_extreme = MathMin(g_extreme, c);
      double fav = (dir == 1) ? (g_extreme - entry) : (entry - g_extreme);
      if(fav >= InpTrailActivateAtr * atr)   // ① 已激活
      {
         double tight = (dir == 1) ? (g_extreme - InpTrailAtrMult * atr)
                                   : (g_extreme + InpTrailAtrMult * atr);
         double newSL = tight;
         if(InpTrailBeBuffer > 0)            // ③ 保本缓冲
         {
            double be = (dir == 1) ? (entry + InpTrailBeBuffer * atr)
                                   : (entry - InpTrailBeBuffer * atr);
            newSL = (dir == 1) ? MathMax(be, tight) : MathMin(be, tight);
         }
         newSL = NormalizeDouble(newSL, g_digits);
         // 同步上移服务器止损(仅更优方向)
         if(InpUseServerStops && g_ticket != 0)
         {
            double curSL = PositionGetDouble(POSITION_SL);
            bool better = (dir == 1) ? (curSL == 0.0 || newSL > curSL)
                                     : (curSL == 0.0 || newSL < curSL);
            if(better && MathAbs(newSL - c) > 0)
               trade.PositionModify(_Symbol, newSL, PositionGetDouble(POSITION_TP));
         }
         // bar 收盘判定(手动模式/兜底): 穿越 tight 才算 trail 命中
         if(dir == 1) { if(c <= tight && c > entry) trailHit = true; }
         else         { if(c >= tight && c < entry) trailHit = true; }
      }
      // 未激活: 不动 SL, 不触发 trailHit(原始硬止损在岗)
   }

   // 手动模式(不挂服务器止损): 在 bar 收盘判定止损/止盈
   if(!InpUseServerStops)
   {
      bool stopHit = false, tpHit = false;
      if(dir == 1)
      {
         if(c <= g_stop)        stopHit = true;
         else if(c >= g_target) tpHit   = true;
      }
      else
      {
         if(c >= g_stop)        stopHit = true;
         else if(c <= g_target) tpHit   = true;
      }
      if(stopHit) { ClosePosition("sl"); return true; }
      if(tpHit)   { ClosePosition("tp"); return true; }
   }
   if(trailHit)  { ClosePosition("tp"); return true; }

   // 隔夜强平(用 MT5 服务器时间, 规避 DST 换算)
   if(InpAvoidOvernight)
   {
      MqlDateTime st;
      TimeToStruct(TimeCurrent(), st);
      if(st.hour >= InpServerCloseHour)
      {
         double rel = 0.0;
         ClassifyChannel(rel);
         bool strong    = (MathAbs(rel) > InpStrongOvernight);
         bool inProfit  = (dir == 1) ? (c > entry) : (c < entry);
         if(!(strong && inProfit))
         {
            ClosePosition("eod");
            return true;
         }
      }
   }
   return false;
}

// 交易起点(服务器时)按 DST 自动对齐北京时间 6:00:
//   夏令时 服务器 GMT+3 → 北京 6:00 = 服务器 01:00 (用输入值)
//   冬令时 服务器 GMT+2 → 北京 6:00 = 服务器 00:00 (输入值 -1)
// TimeGMTOffset() 返回服务器相对 UTC 的秒偏移: GMT+3=10800, GMT+2=7200
int EffectiveStartHour()
{
   if(TimeGMTOffset() >= 3 * 3600) return InpTradeStartHour;   // GMT+3 (DST)
   return InpTradeStartHour - 1;                                // GMT+2 (冬)
}

//=================== 主策略(每根新 M15 bar 执行一次) ===================
void OnNewBar()
{
   g_d_newbar++;
   // 心跳: 每根 bar 打印, 证明 EA 在运行(即便无成交也能在 Experts 看到)
   if(InpHeartbeat)
   {
      MqlDateTime hb; TimeToStruct(iTime(_Symbol, PERIOD_M15, 1), hb);
      int hbOff = TimeGMTOffset() / 3600;
      int sHour = (hb.hour + hbOff) % 24;
      bool inSess = (EffectiveStartHour() <= sHour && sHour < InpTradeEndHour);
      int sp = (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
      PrintFormat("[HB] %04d-%02d-%02d %02d:%02d 服务器=%02d:%02d 新bar=%d 时段=%s 实时点差=%d",
                  hb.year, hb.mon, hb.day, hb.hour, hb.min, sHour, hb.min,
                  g_d_newbar, inSess ? "IN" : "out", sp);
   }
   double atr = GetATRVal(1);             // 已收盘 M15 bar 的 ATR, 对齐回测
   double c   = iClose(_Symbol, PERIOD_M15, 1);  // 已收盘 M15 bar 的收盘价

   // ATR regime 门: 每根 bar 更新 ATR 滚动缓冲(与回测 SMA 跨全样本一致), 计算 atr_avg
   double atr_avg = 0.0;
   if(atr > 0.0)   // 始终维护 atr_avg 环形缓冲(Python 的 atr_avg 永远存在, 距离过滤也依赖它)
   {
      int cap = InpAtrRegimePeriod;
      if(ArraySize(g_atrHist) < cap) ArrayResize(g_atrHist, cap);
      if(g_atrHistN < cap)
      {
         g_atrHist[g_atrHistN] = atr; g_atrHistN++;
      }
      else
      {
         for(int i = 0; i < cap - 1; i++) g_atrHist[i] = g_atrHist[i + 1];
         g_atrHist[cap - 1] = atr;
      }
      if(g_atrHistN >= cap) atr_avg = ArrayMean(g_atrHist, g_atrHistN);  // 预热满窗才生效(否则 atr_avg=0 → 不挡)
   }

   // --- 持仓中: 只做管理 ---
   if(PositionSelect(_Symbol))
   {
      ManagePosition(c, atr);
      return;
   }

   // --- 挂单管理(限价单未成交期间, 仅维护/撤单, 不评估新信号) ---
   if(g_pendingTicket != 0)
   {
      if(!OrderSelect(g_pendingTicket))
      {
         // 挂单已成交/被撤/过期 → 复位(成交由 OnTick 的 fill 检测接管)
         g_pendingTicket = 0; g_pendingDir = 0; g_pendingBar = 0;
      }
      else
      {
         int barsNow = iBars(_Symbol, PERIOD_M15);
         MqlDateTime stSig2; TimeToStruct(iTime(_Symbol, PERIOD_M15, 1), stSig2);
         bool offSession = (stSig2.hour < EffectiveStartHour() || stSig2.hour >= InpTradeEndHour);
         if(offSession)
         {  // 非交易时段撤掉挂单(避免隔夜挂单)
            trade.OrderDelete(g_pendingTicket);
            g_pendingTicket = 0; g_pendingDir = 0; g_pendingBar = 0;
            g_d_session++;
            return;
         }
         if((barsNow - g_pendingBar) >= InpPendingValidBars)
         {  // 超期撤单, 本 bar 重新评估新信号
            trade.OrderDelete(g_pendingTicket);
            g_pendingTicket = 0; g_pendingDir = 0; g_pendingBar = 0;
         }
         else
         {
            return;   // 挂单有效, 等待成交, 本 bar 不再评估新信号
         }
      }
   }

   // --- 交易时段过滤(TMGM 服务器时间, 起点按 DST 自动对齐北京 6:00) ---
   MqlDateTime stSig; TimeToStruct(iTime(_Symbol, PERIOD_M15, 1), stSig);
   if(stSig.hour < EffectiveStartHour() || stSig.hour >= InpTradeEndHour)
   {
      g_d_session++;
      SkipLog(StringFormat("session out hour=%d need[%d,%d)", stSig.hour, EffectiveStartHour(), InpTradeEndHour));
      return;
   }

   // --- 无持仓: 找入场 ---
   double rel = 0.0;
   int channel = ClassifyChannel(rel);
   if(channel == 0) { g_d_chan0++; SkipLog(StringFormat("channel=0 range rel=%.5f", rel)); return; }        // range 不交易(box 只在 up/down 入场)

   int shortDir = ClassifyShortDirection();
   if(channel ==  1 && shortDir < 0) { g_d_conflict++; SkipLog(StringFormat("conflict ch=up shortDir=%d", shortDir)); return; }      // 通道与短周期方向冲突
   if(channel == -1 && shortDir > 0) { g_d_conflict++; SkipLog(StringFormat("conflict ch=down shortDir=%d", shortDir)); return; }

   double sSup, sRes, lSup, lRes;
   ClusterLevels(PERIOD_M15, InpShortWin, sSup, sRes);
   ClusterLevels(PERIOD_H1,  InpLongWin,  lSup, lRes);
   double support    = (sSup > 0.0) ? sSup : lSup;
   double resistance = (sRes > 0.0) ? sRes : lRes;
   if(support <= 0.0 || resistance <= 0.0) { g_d_nolevel++; SkipLog(StringFormat("nolevel sup=%.2f res=%.2f", support, resistance)); return; }

   // want_entry(box) —— 注意: 回测用 data[0](已完成bar), MQL5 已完成 bar = shift=1
   // h/l 必须取已收盘 bar, 否则 OnNewBar 在刚开盘时读到的是零振幅开盘价, 触support条件永不成立
   bool revLong = false, revShort = false;
   DetectReversal(support, resistance, revLong, revShort);
   double h = iHigh (_Symbol, PERIOD_M15, 1);
   double l = iLow  (_Symbol, PERIOD_M15, 1);
   int want = 0;
   if(channel ==  1 && (!InpUseReversalFilter || revLong)  && l <= support    && support    <= c) want =  1;
   if(channel == -1 && (!InpUseReversalFilter || revShort) && c <= resistance && resistance <= h) want = -1;
   if(want == 0) { g_d_want0++; SkipLog(StringFormat("want0 revL=%d revS=%d l<=sup=%d c<=res=%d", revLong, revShort, (int)(l <= support), (int)(c <= resistance))); return; }

   // 趋势过滤
   if(!TrendFilterPass(want, c)) { g_d_trend++; SkipLog(StringFormat("trend want=%d price=%.2f ema=%.2f", want, c, GetMAVal(1))); return; }

   // ATR regime 门(对应 backtrader atr_regime_gate: 当前 ATR / SMA(ATR) > mult 则跳过, 避高波动)
   if(InpAtrRegimeGate && atr_avg > 0.0 && atr / atr_avg > InpAtrRegimeMult)
   { g_d_regime++; SkipLog(StringFormat("regime atr=%.2f avg=%.2f ratio=%.2f>%.2f", atr, atr_avg, atr / atr_avg, InpAtrRegimeMult)); return; }

   // 远离趋势过滤(对应 Python max_ma_dist_atr / ma_dist_lowvol_mult)
   if(InpMaDistMax > 0.0)
   {
      double ma = GetMAVal(1);   // 已收盘 bar EMA, 对齐回测 ma_tf[0]
      if(ma > 0.0 && atr > 0.0)
      {
         bool apply = true;
         if(InpMaDistRegimeCond)
            apply = (atr_avg > 0.0 && atr / atr_avg < InpMaDistLowvolMult);
         if(apply)
         {
            double over = (c - ma) / atr;
            if(want ==  1 && over >  InpMaDistMax) { g_d_madist++; SkipLog(StringFormat("madist long over=%.2f>%.2f (atr/avg=%.2f)", over, InpMaDistMax, atr / atr_avg)); return; }
            if(want == -1 && over < -InpMaDistMax) { g_d_madist++; SkipLog(StringFormat("madist short over=%.2f<%.2f (atr/avg=%.2f)", over, -InpMaDistMax, atr / atr_avg)); return; }
         }
      }
   }

   // RSI 极端过滤(已收盘 bar)
   double rsi = GetRSIVal(1);
   if(channel ==  1 && rsi > InpRsiOverbought) { g_d_rsi++; SkipLog(StringFormat("rsi up rsi=%.1f>%.1f", rsi, InpRsiOverbought)); return; }
   if(channel == -1 && rsi < InpRsiOversold)   { g_d_rsi++; SkipLog(StringFormat("rsi down rsi=%.1f<%.1f", rsi, InpRsiOversold)); return; }

   // 同向冷却
   int barsNow = iBars(_Symbol, PERIOD_M15);
   if(g_lastEntrySide == want && (barsNow - g_lastEntryBar) < InpCooldownBars) { g_d_cool++; SkipLog(StringFormat("cooldown want=%d gap=%d", want, barsNow - g_lastEntryBar)); return; }

   // 点差过滤(回测无此项, 实盘必需)
   if(!SpreadOK()) { g_d_spread++; SkipLog(StringFormat("spread=%d>%d", (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD), InpMaxSpreadPoints)); return; }

   // 计算止损止盈(基于信号收盘价 c, 与回测一致)
   double stop, target;
   if(InpUseAtrStop)
   {
      if(want == 1) { stop = c - InpAtrStopMult * atr; target = c + InpRMult * (c - stop); }
      else          { stop = c + InpAtrStopMult * atr; target = c - InpRMult * (stop - c); }
   }
   else
   {
      if(want == 1) { stop = support - 2.0;    target = c + InpRMult * (c - stop); }
      else          { stop = resistance + 2.0; target = c - InpRMult * (stop - c); }
   }

   g_lastEntryBar  = barsNow;
   g_lastEntrySide = want;
   g_d_attempt++;
   PrintFormat("[ATTEMPT] want=%d price=%.2f sl=%.2f tp=%.2f spread=%d", want, c, stop, target, (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD));
   OpenPosition(want, c, stop, target);
}

//=================== 事件 ===================
int OnInit()
{
   trade.SetExpertMagicNumber(InpMagic);
   trade.SetDeviationInPoints(20);
   trade.SetTypeFillingBySymbol(_Symbol);

   g_point  = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   g_digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN,  g_volMin);
   SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP, g_volStep);
   SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX,  g_volMax);

   // 创建指标句柄
   g_hMA  = iMA (_Symbol, PERIOD_M15, InpMAFilterPeriod, 0, MODE_EMA, PRICE_CLOSE);
   g_hATR = iATR(_Symbol, PERIOD_M15, InpAtrPeriod);
   g_hRSI = iRSI(_Symbol, PERIOD_M15, InpRsiPeriod, PRICE_CLOSE);
   if(g_hMA == INVALID_HANDLE || g_hATR == INVALID_HANDLE || g_hRSI == INVALID_HANDLE)
   {
      Print("错误: 指标句柄创建失败");
      return(INIT_FAILED);
   }

   if(_Period != PERIOD_M15)
      Print("警告: 本 EA 设计为运行在 XAUUSD M15 图表, 当前图表周期为 ", EnumToString(_Period));
   if(InpFixedLot < g_volMin - 1e-9)
      PrintFormat("警告: 设定手数 %.3f 小于品种最小手数 %.3f, 已自动上调", InpFixedLot, g_volMin);

   PrintFormat("BoxChannelScalp 初始化完成 | 手数=%.2f 服务器强平时点=%d:00 服务器SL/TP=%s",
               NormalizeLot(InpFixedLot), InpServerCloseHour, (InpUseServerStops ? "开" : "关(手动bar收盘)"));
   PrintFormat("[CFG] lot=%.2f maxSpread=%d sess=[%d,%d) trail=%s atrStop=%.2f trailAct=%.2f maDist=%.2f regime=%s magic=%d",
               NormalizeLot(InpFixedLot), InpMaxSpreadPoints, EffectiveStartHour(), InpTradeEndHour,
               (InpTrailing ? "on" : "off"), InpAtrStopMult, InpTrailActivateAtr, InpMaDistMax,
               (InpAtrRegimeGate ? "on" : "off"), (int)InpMagic);

   // 每次回测清空旧 CSV(截断写表头), 避免多 run 累积导致对拍文件含跨 run 行
   if(InpLogTrades)
   {
      int h = FileOpen("BoxChannelScalp_trades.csv", FILE_CSV | FILE_WRITE | FILE_ANSI, ',');
      if(h != INVALID_HANDLE)
      {
         FileWrite(h, "time", "action", "side", "price", "stop", "target", "profit", "swap", "reason");
         FileClose(h);
      }
   }
   return(INIT_SUCCEEDED);
}

void OnDeinit(const int reason)
{
   // 对拍诊断：策略测试器/图表卸载时打印，OnTester 可能不被调用，OnDeinit 一定触发
   PrintFormat("[DIAG] newbar=%d chan0=%d conflict=%d nolevel=%d want0=%d trend=%d rsi=%d cool=%d spread=%d regime=%d madist=%d session=%d pend=%d attempt=%d opened=%d",
               g_d_newbar, g_d_chan0, g_d_conflict, g_d_nolevel, g_d_want0,
               g_d_trend, g_d_rsi, g_d_cool, g_d_spread, g_d_regime, g_d_madist, g_d_session, g_d_pend, g_d_attempt, g_d_open);

   if(g_hMA  != INVALID_HANDLE) IndicatorRelease(g_hMA);
   if(g_hATR != INVALID_HANDLE) IndicatorRelease(g_hATR);
   if(g_hRSI != INVALID_HANDLE) IndicatorRelease(g_hRSI);
}

void OnTick()
{
   // 存活探针: 每 ~60s 打一次, 证明 OnTick 在吃 tick(即便没新 bar 也能看到)
   static datetime s_lastTick = 0;
   if(TimeCurrent() - s_lastTick >= 60) { s_lastTick = TimeCurrent(); PrintFormat("[TICK] alive symbol=%s spread=%d", _Symbol, (int)SymbolInfoInteger(_Symbol, SYMBOL_SPREAD)); }

   // 持仓期间每 tick 刷新累计隔夜费(平仓时写入 CSV, 与 MT5 账户级 swap 对齐)
   if(PositionSelect(_Symbol))
      g_position_swap = PositionGetDouble(POSITION_SWAP);

   // 检测仓位是否被服务器(止损/止盈/强平)关掉 → 记日志并复位
   if(g_ticket != 0 && !PositionSelect(_Symbol))
   {
      LogClosedByHistory(g_ticket, g_closeReason);
      g_ticket = 0; g_dir = 0; g_entryPrice = 0; g_stop = 0; g_target = 0; g_extreme = 0;
      g_closeReason = ""; g_position_swap = 0.0;
   }

   // 挂单成交检测: 限价单已成交 → 转持仓, 记 open 日志(与 pend 配对, 不破坏 CSV 配对)
   if(g_pendingTicket != 0 && PositionSelect(_Symbol) && g_ticket == 0)
   {
      g_ticket     = PositionGetInteger(POSITION_TICKET);
      g_dir        = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? 1 : -1;
      g_entryPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      g_extreme    = g_entryPrice;
      g_pendingTicket = 0; g_pendingDir = 0; g_pendingBar = 0;
      g_d_open++;
      LogTrade("open", g_entryPrice);
      PrintFormat("[OPEN FILLED] %s entry=%.2f sl=%.2f tp=%.2f",
                  (g_dir == 1 ? "BUY" : "SELL"), g_entryPrice, g_stop, g_target);
   }

   datetime t = iTime(_Symbol, PERIOD_M15, 0);
   if(t == g_lastBarTime) return;    // 仅在新 bar 执行, 避免每 tick 重复计算
   g_lastBarTime = t;

   OnNewBar();
}

//=================== 对拍诊断(测试结束时打印, 不影响交易) ===================
double OnTester()
{
   PrintFormat("[DIAG] newbar=%d chan0=%d conflict=%d nolevel=%d want0=%d trend=%d rsi=%d cool=%d spread=%d regime=%d madist=%d session=%d pend=%d attempt=%d opened=%d",
               g_d_newbar, g_d_chan0, g_d_conflict, g_d_nolevel, g_d_want0,
               g_d_trend, g_d_rsi, g_d_cool, g_d_spread, g_d_regime, g_d_madist, g_d_session, g_d_pend, g_d_attempt, g_d_open);
   return 0.0;
}
//+------------------------------------------------------------------+
